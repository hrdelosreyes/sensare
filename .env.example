# Neon Postgres (set automatically by the Vercel ↔ Neon integration)
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Daily partner job (/api/cron/partners)
CRON_SECRET=

# Email + payments
RESEND_API_KEY=
HITPAY_API_KEY=
HITPAY_SALT=
NEXT_PUBLIC_HITPAY_MODE=sandbox
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Meta Pixel + Conversions API (ad measurement; off until both are set)
NEXT_PUBLIC_META_PIXEL_ID=
META_ACCESS_TOKEN=
# Optional: TEST12345 from Events Manager → Test events, while testing. Leave blank in production.
META_TEST_EVENT_CODE=

# Only until the first admin is created at /admin/setup
ADMIN_PASSWORD=

# Only during the one-time move from Supabase (copies shop data on deploy)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
